# Environment contract for tayler-carney-portfolio.
#
# Copy to `.env.local` for development, and set the same keys in the Vercel
# project settings for production. Every variable here is server-only — none is
# NEXT_PUBLIC_, and none should ever be exposed to the browser.
#
# These are validated at build time by src/lib/env.ts (wired in from
# next.config.ts), so a missing or malformed value fails the deploy rather than
# silently degrading the live site.

# --- Site identity -----------------------------------------------------------

# Absolute public origin, no trailing slash. Drives metadataBase, every
# OpenGraph URL, and every sitemap entry.
# Missing => canonical URLs point at http://localhost:3000 in production and the
# sitemap emits bare relative paths that search engines reject.
WEBSITE_URL=https://example.com

# --- Hygraph (CMS) -----------------------------------------------------------

# Content API endpoint. Find it in Hygraph under Project Settings > API Access.
# Note: if this is a read-only CDN host (*.cdn.hygraph.com), writes are rejected
# and you must also set CMS_MUTATION_ENDPOINT below.
CMS_ENDPOINT=https://eu-west-2.hygraph.com/v2/<project-id>/master

# Read token for PUBLISHED content. Needs Read on every public model.
CMS_TOKEN=

# Token used for draft reads and every admin write. Needs, per model:
#   Project, SiteData  -> Read (Draft) + Update (Draft) + Publish
#   Asset              -> Create + Read (Draft) + Update (Draft)
#                         + Publish + Unpublish + Delete
# A "permission errors" message in the admin UI means this token's scope is
# short, not that there is a code bug.
HYGRAPH_MUTATION_TOKEN=

# Optional. Set only when CMS_ENDPOINT is a *.cdn.hygraph.com host — the read
# CDN rejects mutations, so writes need the regular Content API host here.
# CMS_MUTATION_ENDPOINT=https://eu-west-2.hygraph.com/v2/<project-id>/master

# --- Admin -------------------------------------------------------------------

# The admin login secret. This is also the HMAC key used to sign the session
# cookie, so it does double duty and must be long and random.
#   Minimum 16 characters (enforced at build time).
#   Generate one with:  openssl rand -base64 32
# Rotating this immediately invalidates every existing admin session.
ADMIN_KEY=

# --- CI ----------------------------------------------------------------------

# Set only in CI. Skips the build-time environment check so the app can be
# built to prove it compiles, without production secrets present.
# SKIP_ENV_VALIDATION=1
